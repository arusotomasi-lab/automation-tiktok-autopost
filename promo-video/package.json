{
  "name": "tiktok-automation-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic promo video for the TikTok automation system (Remotion).",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "still": "node scripts/stills.mjs",
    "render:video": "remotion render src/index.ts Promo cache/scene-renders/video-noaudio-v2.mp4 --muted --codec=h264 --crf=16 --concurrency=6 --gl=angle",
    "audio": "node scripts/audio.mjs",
    "mux": "node scripts/mux.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/install-whisper-cpp": "^4.0.534",
    "@types/react": "19.2.2",
    "ffmpeg-static": "^5.2.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true,
    "esbuild@0.28.1": true
  }
}
